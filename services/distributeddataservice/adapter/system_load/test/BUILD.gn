import("//build/ohos.gni")
import("//build/test.gni")
import("//foundation/distributeddatamgr/datamgr_service/datamgr_service.gni")

ohos_unittest("SystemLoadMonitorTest") {
  module_out_path = "datamgr_service/datamgr_service/distributeddatafwk"
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    boundary_sanitize = true
    ubsan = true
  }
  sources = [ "system_load_monitor_test.cpp" ]
  include_dirs = [ ".." ]
  cflags = [ "-fno-access-control" ]
  external_deps = [
    "googletest:gtest_main",
    "hilog:libhilog",
    "kv_store:datamgr_common",
  ]
  if (datamgr_service_resource) {
    defines = [ "DATAMGR_RESOURCE_SCHEDULE_PART_ENABLED" ]
    external_deps += [
      "resource_schedule_service:ressched_client",
      "samgr:samgr_proxy",
    ]
  }
  deps = [
    "${data_service_path}/adapter/system_load:distributeddata_system_load",
    "${data_service_path}/framework:distributeddatasvcfwk",
  ]
  subsystem_name = "distributeddatamgr"
  part_name = "datamgr_service"
}

group("unittest") {
  testonly = true
  deps = [ ":SystemLoadMonitorTest" ]
}
