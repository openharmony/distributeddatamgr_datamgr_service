import("//build/ohos.gni")
import("//foundation/distributeddatamgr/datamgr_service/datamgr_service.gni")

ohos_source_set("distributeddata_system_load") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  sources = [ "system_load_monitor_impl.cpp" ]
  include_dirs = [ "." ]
  cflags_cc = [ "-fvisibility=hidden" ]

  deps = [ "${data_service_path}/framework:distributeddatasvcfwk" ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "kv_store:datamgr_common",
  ]

  if (datamgr_service_resource) {
    defines = [ "DATAMGR_RESOURCE_SCHEDULE_PART_ENABLED" ]
    external_deps += [
      "resource_schedule_service:ressched_client",
      "samgr:samgr_proxy",
    ]
  }

  subsystem_name = "distributeddatamgr"
  part_name = "datamgr_service"
}
